# Python
__pycache__/
*.pyc
*.pyo

# LaTeX build artifacts (Overleaf rebuilds these)
*.aux
*.log
*.bbl
*.blg
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
manuscript/build.log
manuscript/final.log

# All PDFs: compiled manuscript (regenerated by Overleaf) + copyrighted reference papers
# (Kuklin 2017, Modarresi 2019) which must not be redistributed.
*.pdf

# Regenerable transmission caches (rebuild via the scripts)
data/*.npz

# Full-text markdown conversions of copyrighted reference papers — must not be
# redistributed (same rule as the reference PDFs above).
papers_md/

# NotebookLM video overviews (large, regenerable) and personal notebook pointer
overviews/
.notebooklm

# elsarticle byproduct
*.spl

# publisher page renders and working copies (never public)
data/kuklin_p4_300dpi*.png
manuscript/*.bak
manuscript/manuscript_polished.tex
